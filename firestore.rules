rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read, write: if isAdmin();
    }

    match /children/{childId} {
      allow read, write: if isAdmin();
    }

    match /childProgress/{childId}/sections/{sectionId} {
      allow read, write: if isAdmin();
    }

    match /gameCues/{cueId} {
      allow read, write: if isAdmin();
    }

    match /gardenPhases/{phaseId} {
      allow read, write: if isAdmin();
    }

    match /gardenLevels/{levelId} {
      allow read, write: if isAdmin();
    }

    match /jailbreakThemes/{themeId} {
      allow read, write: if isAdmin();
    }

    match /jailbreakMatches/{matchId} {
      allow read, write: if isAdmin();
    }

    match /jailbreakMatches/{matchId}/turns/{turnId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
