# Firebase Configuration (for Admin Auth only)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (for Auth token verification)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# MongoDB Configuration
# Format: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=

# AI Services - OpenRouter
OPENROUTER_API_KEY=
# Optional: defaults shown below
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=https://taichung-hoc.local
# OPENROUTER_APP_TITLE=Taichung HOC

# AI Services - Google Gemini
# Optional: defaults to gemini-2.0-flash-exp
# GEMINI_FLASH_IMAGE_MODEL=gemini-2.0-flash-exp
# NEXT_PUBLIC_GEMINI_FLASH_IMAGE_MODEL=gemini-2.0-flash-exp
# GEMINI_FLASH_TEXT_MODEL=gemini-2.0-flash-exp
# NEXT_PUBLIC_GEMINI_FLASH_TEXT_MODEL=gemini-2.0-flash-exp

# Cloudflare R2 Storage
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Child Session Security
CHILD_SESSION_SECRET=

# Environment
# NODE_ENV=production
